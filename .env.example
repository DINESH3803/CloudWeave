# Copy to `.env` and replace placeholders. Never commit `.env`.

# --- PostgreSQL (metadata database) ---
POSTGRES_DB=cloudweave
POSTGRES_USER=cloudweave
POSTGRES_PASSWORD=<set-a-password>

# --- Controller ---
CONTROLLER_PORT=8000
CHUNK_SIZE_BYTES=1048576
REPLICATION_FACTOR=2
HEARTBEAT_TIMEOUT_SECONDS=15

# --- Workers ---
HEARTBEAT_INTERVAL_SECONDS=5

# --- Shared ---
# Secret for internal controller <-> worker HTTP calls
INTERNAL_API_TOKEN=<set-a-secret-token>
LOG_LEVEL=INFO

# --- Client ---
CLOUDWEAVE_URL=http://localhost:8000
